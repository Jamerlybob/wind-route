<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trip_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/trip_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back" android:padding="12dp" android:src="@drawable/ic_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/trip_title"
                android:textAppearance="@style/TextAppearance.WindRoute.Headline" />
        </LinearLayout>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/trip_map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent" android:layout_height="220dp"
            android:layout_marginBottom="12dp" />
        <RadioGroup android:id="@+id/split_mode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/split_distance" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:text="@string/split_distance" />
            <RadioButton android:id="@+id/split_days" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/split_days" />
        </RadioGroup>
        <TextView android:id="@+id/daily_distance_label" style="@style/Widget.WindRoute.SectionTitle" android:text="@string/how_far_day" />
        <com.google.android.material.slider.Slider android:id="@+id/daily_slider"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:contentDescription="@string/how_far_day" app:tickVisible="false" />
        <LinearLayout android:id="@+id/day_stepper" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/day_minus"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="56dp" android:layout_height="48dp"
                android:text="@string/minus_symbol" android:contentDescription="@string/fewer_days" />
            <TextView android:id="@+id/day_count" android:layout_width="64dp" android:layout_height="48dp"
                android:gravity="center" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/day_plus"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="56dp" android:layout_height="48dp"
                android:text="@string/plus_symbol" android:contentDescription="@string/more_days" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/more_options"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/more_options" />
        <LinearLayout android:id="@+id/trip_more" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/count_climbing"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/count_climbing" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/trip_start_date"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/trip_start_time"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>
        <TextView style="@style/Widget.WindRoute.SectionBody" android:text="@string/gap_threshold_hint" />
        <EditText android:id="@+id/gap_threshold" android:layout_width="match_parent"
            android:layout_height="48dp" android:hint="@string/gap_threshold_hint"
            android:importantForAutofill="no" android:inputType="numberDecimal" android:text="@string/default_gap_threshold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/shift_earlier"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shift_earlier" />
            <com.google.android.material.button.MaterialButton android:id="@+id/shift_later"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shift_later" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/best_trip"
            style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" android:textAllCaps="false" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/trip_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
        <LinearLayout android:id="@+id/trip_days_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/trip_find_places"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/find_places" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/trip_places_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/trip_places_status" style="@style/Widget.WindRoute.SectionBody"
            android:visibility="gone" />
        <TextView android:id="@+id/trip_places_credit" style="@style/Widget.WindRoute.SectionBody"
            android:text="@string/osm_credit" android:visibility="gone" />
        <LinearLayout android:id="@+id/trip_places_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save_trip"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/save_trip" />
        <TextView style="@style/Widget.WindRoute.SectionBody" android:text="@string/map_offline_notice" />
        <TextView android:id="@+id/forecast_age" style="@style/Widget.WindRoute.SectionBody" />
    </LinearLayout>
</ScrollView>
