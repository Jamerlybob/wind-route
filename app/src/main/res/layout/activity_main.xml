<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        style="@style/Widget.WindRoute.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/search_collapsed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/search_collapsed_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <ImageButton
                    android:id="@+id/settings_collapsed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_menu"
                    android:padding="12dp"
                    android:src="@drawable/ic_more_vert" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/search_expanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/origin_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_origin"
                    app:endIconContentDescription="@string/use_my_location"
                    app:endIconDrawable="@drawable/ic_my_location"
                    app:endIconMode="custom">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/origin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destination_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_destination"
                    app:endIconContentDescription="@string/swap_places"
                    app:endIconDrawable="@drawable/ic_swap_vertical"
                    app:endIconMode="custom">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/open_menu"
                        android:padding="8dp"
                        android:src="@drawable/ic_more_vert" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/depart_chips"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        app:chipSpacingHorizontal="4dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/depart_now"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/depart_now" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/depart_choose"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/depart_choose" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/go"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/button_go" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stretch_card"
        style="@style/Widget.WindRoute.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="412dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/stretch_facts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/ride_banner"
        style="@style/Widget.WindRoute.Card" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="top"
        android:layout_margin="12dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">
            <TextView android:id="@+id/ride_instruction" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WindRoute.Headline" />
            <TextView android:id="@+id/ride_warnings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/off_route_banner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center_vertical"
                android:orientation="horizontal" android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/off_route"
                    android:textColor="@color/wind_headwind" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reroute"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/reroute_from_here" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/ride_strip"
        style="@style/Widget.WindRoute.Card" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_margin="12dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">
            <io.github.jamerlybob.windroute.ElevationProfileView android:id="@+id/ride_elevation"
                android:layout_width="match_parent" android:layout_height="100dp" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/ride_wind_arrow" android:layout_width="40dp"
                android:layout_height="40dp" android:gravity="center" android:text="@string/ride_wind_arrow"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" android:importantForAccessibility="no" />
            <TextView android:id="@+id/ride_stats" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/stop_ride"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stop_ride" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/summary_card"
        style="@style/Widget.WindRoute.Card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.6"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/summary_collapsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">
                <View android:layout_width="40dp" android:layout_height="4dp"
                    android:layout_gravity="center_horizontal" android:layout_marginBottom="6dp"
                    android:background="?attr/colorOutlineVariant" />
                <TextView android:id="@+id/headline" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.WindRoute.Headline" />
                <TextView android:id="@+id/details_primary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:id="@+id/details_secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:id="@+id/details_headwind" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/wind_headwind" android:visibility="gone" />
                <TextView android:id="@+id/reverse_comparison" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorPrimary" android:visibility="gone" />
                <LinearLayout android:id="@+id/share_bar" android:layout_width="match_parent"
                    android:layout_height="10dp" android:layout_marginTop="10dp"
                    android:background="@drawable/share_bar_clip" android:clipToOutline="true"
                    android:orientation="horizontal">
                    <View android:id="@+id/bar_headwind" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/wind_headwind" />
                    <View android:id="@+id/bar_crosswind" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/wind_crosswind" />
                    <View android:id="@+id/bar_tailwind" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/wind_tailwind" />
                    <View android:id="@+id/bar_calm" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/wind_calm" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal">
                    <TextView android:id="@+id/legend_headwind" style="@style/Widget.WindRoute.Legend" app:drawableStartCompat="@drawable/dot_headwind" />
                    <TextView android:id="@+id/legend_crosswind" style="@style/Widget.WindRoute.Legend" app:drawableStartCompat="@drawable/dot_crosswind" />
                    <TextView android:id="@+id/legend_tailwind" style="@style/Widget.WindRoute.Legend" app:drawableStartCompat="@drawable/dot_tailwind" />
                    <TextView android:id="@+id/legend_calm" style="@style/Widget.WindRoute.Legend" app:drawableStartCompat="@drawable/dot_calm" />
                </LinearLayout>
                <TextView android:id="@+id/warnings" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:maxLines="2" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />

                <com.google.android.material.button.MaterialButton android:id="@+id/start_ride"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/start_ride" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/summary_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/summary_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="32dp">
                    <TextView android:id="@+id/best_summary" style="@style/Widget.WindRoute.SectionTitle" />
                    <io.github.jamerlybob.windroute.DepartureStripView
                        android:id="@+id/departure_strip" android:layout_width="match_parent"
                        android:layout_height="180dp" android:layout_marginTop="4dp" />
                    <TextView style="@style/Widget.WindRoute.SectionTitle" android:text="@string/weather_title" />
                    <TextView android:id="@+id/weather_summary" style="@style/Widget.WindRoute.SectionBody" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/wind_cost" style="@style/Widget.WindRoute.SectionTitle"
                            android:layout_width="wrap_content" android:minHeight="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true" android:contentDescription="@string/wind_cost_info"
                            app:drawableEndCompat="@android:drawable/ic_menu_info_details"
                            android:drawablePadding="6dp" android:focusable="true"
                            android:gravity="center_vertical" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/gust_section" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <TextView style="@style/Widget.WindRoute.SectionTitle" android:text="@string/gust_warnings_title" />
                        <LinearLayout android:id="@+id/gust_list" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                    <TextView style="@style/Widget.WindRoute.SectionTitle" android:text="@string/hills_title" />
                    <TextView android:id="@+id/hills_status" style="@style/Widget.WindRoute.SectionBody" />
                    <io.github.jamerlybob.windroute.ElevationProfileView
                        android:id="@+id/elevation_profile" android:layout_width="match_parent"
                        android:layout_height="210dp" android:layout_marginTop="6dp" android:visibility="gone" />
                    <LinearLayout android:id="@+id/climbs_list" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:id="@+id/find_places" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="18dp"
                        android:text="@string/find_places" />
                    <TextView android:id="@+id/places_credit" style="@style/Widget.WindRoute.SectionBody"
                        android:text="@string/osm_credit" android:visibility="gone" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/places_progress" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
                    <TextView android:id="@+id/places_status" style="@style/Widget.WindRoute.SectionBody"
                        android:visibility="gone" />
                    <LinearLayout android:id="@+id/places_list" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
