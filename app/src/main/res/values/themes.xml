<resources>
    <!-- Material builds every button, chip, card and text field out of the
         named colour roles below, so setting them here restyles the whole app.
         The values come from colors.xml, which has a light and a dark version. -->
    <style name="Base.Theme.WindRoute" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorSurfaceContainerLow">@color/brand_card</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outline_variant</item>
    </style>

    <style name="Theme.WindRoute" parent="Base.Theme.WindRoute" />

    <style name="Widget.WindRoute.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">6dp</item>
        <item name="shapeAppearance">?attr/shapeAppearanceLargeComponent</item>
    </style>

    <!-- The one line that answers "what is the wind doing?", so it is the
         largest and heaviest text on the screen. -->
    <style name="TextAppearance.WindRoute.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.WindRoute.Legend" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="Widget.WindRoute.SettingLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="Widget.WindRoute.SettingSpinner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
    </style>
</resources>
